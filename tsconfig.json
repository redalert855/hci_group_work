{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@/*": ["./src/*"] // Allows for absolute imports from the src directory using the @ alias
        },
        "resolveJsonModule": true,
        "skipLibCheck": true,
        /* Linting */
        "strict": true,
        "strictNullChecks": true,
        "target": "ESNext",
        "types": ["vite/client"],
        "rootDir": "."
    },
    "exclude": ["**/node_modules/**"],
    "include": [
        "./src/**/*.ts",
        "./src/**/*.d.ts",
        "./src/**/*.tsx",
        ".*.mjs",
        "./.storybook/**/*.ts",
        "./.storybook/**/*.tsx",
        "./storybook",
        "eslint.config.mjs"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
