{
    "name": "hci_group_work",
    "version": "1.0.0",
    "description": "Card Manager",
    "keywords": [
        "card",
        "organise",
        "magic",
        "the",
        "gathering"
    ],
    "homepage": "https://github.com/redalert855/hci_group_work#readme",
    "bugs": {
        "url": "https://github.com/redalert855/hci_group_work/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/redalert855/hci_group_work.git"
    },
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "build": "tsc && vite build",
        "build-deploy": "tsc && vite build && firebase deploy",
        "coverage": "vitest run --coverage",
        "deploy": "firebase deploy",
        "find-unused": "npx unimported",
        "firebaseReAuth": "firebase login --reauth",
        "lint": "eslint src",
        "lint-and-autofix": "eslint src --fix",
        "serve": "vite preview",
        "start": "vite --host",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test": "vitest",
        "test:coverage": "vitest run --coverage --watch=false",
        "types": "chakra typegen ./src/components/chakra/theme.ts",
        "types:watch": "chakra typegen ./src/components/chakra/theme.ts --watch",
        "update-and-install": "npx npm-check-updates -u && npm install",
        "update-with-choice": "npx npm-check-updates -i && npm install",
        "update-check": "npx npm-check-updates"
    },
    "dependencies": {
        "@chakra-ui/react": "^3.35.0",
        "@emotion/react": "^11.14.0",
        "@reduxjs/toolkit": "^2.11.2",
        "@vitejs/plugin-react": "^6.0.1",
        "next-themes": "^0.4.6",
        "react-dom": "^19.2.4",
        "react-redux": "^9.2.0",
        "react-router": "^7.15.0",
        "react-toastify": "^11.0.5",
        "storybook": "^10.3.6",
        "vite": "^8.0.12"
    },
    "devDependencies": {
        "@iconify/react": "^6.0.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "prettier-plugin-jsdoc": "^1.8.0"
    }
}
